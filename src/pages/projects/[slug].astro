---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { basics, projects } from "@mycvdata";

type Screenshot = { file: string; label: string; path: string };
type StackEntry = [string, string];

function slugify(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

export function getStaticPaths() {
  const slugify = (name: string): string =>
    name
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  return (projects ?? []).map((project: any) => ({
    params: { slug: slugify(project.name) },
    props: { project },
  }));
}

const { project } = Astro.props as { project: any };
const {
  name,
  description,
  highlights = [],
  langIcon,
  isActive,
  url: projectUrl,
  github,
  stack = {},
  screenshots = [],
} = project;

const galleryId = `gallery-${name.replace(/[^a-z0-9]/gi, "-")}`;
const baseUrl = import.meta.env.BASE_URL;
const firstScreenshot: Screenshot | undefined = screenshots[0];
const projectIndex = projects.findIndex((item: any) => item.name === name);
const projectNumber = String(projectIndex + 1).padStart(2, "0");
const nextProject = projects[(projectIndex + 1) % projects.length];
---

<Layout
  title={`${name} — ${basics.name}`}
  description={description}
  canonicalURL={`${baseUrl}projects/${slugify(name)}`}
  image={firstScreenshot
    ? `${baseUrl}${firstScreenshot.path}/${firstScreenshot.file}`
    : undefined}
>
  <div class="min-h-screen overflow-hidden text-skin-base">
    <header
      class="sticky top-0 z-50 border-b border-skin-muted/15 bg-skin-fill/80 backdrop-blur-xl print:hidden"
    >
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8"
      >
        <a
          href={baseUrl}
          class="group flex items-center gap-2 text-sm text-skin-muted transition-colors hover:text-skin-base"
        >
          <Icon
            name="ri:arrow-left-line"
            class="h-4 w-4 transition-transform group-hover:-translate-x-1"
          />
          <span>Portfolio</span>
        </a>
        <span class="font-mono text-xs tracking-[0.2em] text-skin-muted"
          >SPECIAL PROJECT <span class="mx-1 text-skin-hue">/</span>
          {projectNumber}</span
        >
      </div>
    </header>

    <main class="relative mx-auto max-w-6xl px-5 pb-16 pt-10 sm:px-8 sm:pt-16">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-48 top-0 -z-10 h-96 w-96 rounded-full bg-skin-hue/10 blur-[120px]"
      >
      </div>

      <section
        class="grid gap-8 pb-10 sm:gap-10 lg:grid-cols-[1fr_auto] lg:items-end"
      >
        <div class="max-w-4xl">
          <p
            class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.24em] text-skin-hue"
          >
            <span class="h-px w-8 bg-skin-hue"></span> Project case study
          </p>
          <div class="mb-5 flex flex-wrap items-center gap-2.5">
            <span
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-skin-muted/20 bg-skin-button-muted text-skin-hue"
            >
              <Icon name={langIcon ?? "mdi:code"} class="h-5 w-5" />
            </span>
            <span
              class:list={[
                "rounded-full border px-3 py-1 text-xs font-medium",
                isActive
                  ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-500"
                  : "border-skin-muted/25 bg-skin-button-muted text-skin-muted",
              ]}
            >
              <span
                class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-current"
              ></span>{isActive ? "Live project" : "Archived project"}
            </span>
            {
              screenshots.length > 0 && (
                <span class="text-xs text-skin-muted">
                  {screenshots.length}{" "}
                  {screenshots.length === 1 ? "screen" : "screens"}
                </span>
              )
            }
          </div>
          <h1
            class="max-w-4xl text-4xl font-bold leading-[1.05] tracking-tight text-skin-base sm:text-6xl lg:text-7xl"
          >
            {name}
          </h1>
          <p
            class="mt-6 max-w-3xl text-base leading-7 text-skin-muted sm:text-lg sm:leading-8"
          >
            {description}
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end print:hidden">
          {
            isActive && projectUrl && (
              <a
                href={projectUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2 rounded-full bg-skin-button-accent px-5 py-3 text-sm font-semibold text-skin-inverted shadow-lg shadow-skin-hue/20 transition hover:-translate-y-0.5 hover:bg-skin-button-accent-hover"
              >
                Explore project{" "}
                <Icon
                  name="ri:arrow-right-up-line"
                  class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                />
              </a>
            )
          }
          {
            github && (
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-skin-muted/25 bg-skin-button-muted/60 px-5 py-3 text-sm font-medium text-skin-base transition hover:border-skin-hue/60 hover:text-skin-hue"
              >
                <Icon name="mdi:github" class="h-4 w-4" /> Source code
              </a>
            )
          }
        </div>
      </section>

      {
        screenshots.length > 0 ? (
          <section
            aria-label="Project screenshots"
            class="relative mb-16"
            data-carousel
          >
            <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-br from-skin-hue/20 via-transparent to-skin-hue/5 blur-xl" />
            <div class="group/car relative aspect-[16/9] overflow-hidden rounded-2xl border border-white/10 bg-[#101010] shadow-2xl shadow-black/30 sm:rounded-3xl">
              <div
                aria-hidden="true"
                class="absolute inset-x-0 top-0 z-20 flex h-10 items-center gap-1.5 border-b border-white/10 bg-black/30 px-4 backdrop-blur-sm"
              >
                <>
                  <span class="h-2 w-2 rounded-full bg-red-400/80" />
                  <span class="h-2 w-2 rounded-full bg-yellow-400/80" />
                  <span class="bg-green-400/80 h-2 w-2 rounded-full" />
                </>
                <span class="ml-3 font-mono text-[10px] tracking-wide text-white/40">
                  PROJECT PREVIEW
                </span>
              </div>
              {screenshots.map(
                ({ file, label, path }: Screenshot, idx: number) => (
                  <a
                    href={`${baseUrl}${path}/${file}`}
                    data-fancybox={galleryId}
                    data-caption={label || name}
                    class:list={[
                      "carousel-slide absolute inset-0 pt-10 transition-opacity duration-500 ease-in-out",
                      idx === 0
                        ? "z-10 opacity-100"
                        : "pointer-events-none z-0 opacity-0",
                    ]}
                  >
                    <img
                      src={`${baseUrl}${path}/${file}`}
                      alt={label || `${name} screenshot ${idx + 1}`}
                      class="h-full w-full object-contain"
                      loading={idx === 0 ? "eager" : "lazy"}
                    />
                  </a>
                ),
              )}
              <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 flex items-end justify-between bg-gradient-to-t from-black/80 via-black/25 to-transparent px-5 pb-5 pt-14 sm:px-7 sm:pb-7">
                <p
                  class="max-w-[70%] truncate text-sm font-medium text-white"
                  data-carousel-caption
                >
                  {screenshots[0].label || name}
                </p>
                <span
                  class="rounded-full border border-white/15 bg-black/40 px-3 py-1 font-mono text-xs tabular-nums text-white/75 backdrop-blur"
                  data-carousel-counter
                >
                  01 / {String(screenshots.length).padStart(2, "0")}
                </span>
              </div>
              {screenshots.length > 1 && (
                <Fragment>
                  <button
                    type="button"
                    aria-label="Previous screenshot"
                    class="carousel-prev absolute left-3 top-1/2 z-30 -translate-y-1/2 rounded-full border border-white/15 bg-black/45 p-2.5 text-white backdrop-blur transition hover:bg-skin-hue sm:left-5"
                  >
                    <Icon name="ri:arrow-left-s-line" class="h-5 w-5" />
                  </button>
                  <button
                    type="button"
                    aria-label="Next screenshot"
                    class="carousel-next absolute right-3 top-1/2 z-30 -translate-y-1/2 rounded-full border border-white/15 bg-black/45 p-2.5 text-white backdrop-blur transition hover:bg-skin-hue sm:right-5"
                  >
                    <Icon name="ri:arrow-right-s-line" class="h-5 w-5" />
                  </button>
                </Fragment>
              )}
              <span class="pointer-events-none absolute right-4 top-14 z-30 rounded-full border border-white/15 bg-black/45 p-2 text-white/80 opacity-0 backdrop-blur transition group-hover/car:opacity-100">
                <Icon name="ri:fullscreen-line" class="h-4 w-4" />
              </span>
            </div>
            {screenshots.length > 1 && (
              <div
                class="mt-4 flex gap-3 overflow-x-auto pb-2 scrollbar-thin scrollbar-track-transparent scrollbar-thumb-skin-hue"
                data-carousel-thumbs
              >
                {screenshots.map(
                  ({ file, label, path }: Screenshot, idx: number) => (
                    <button
                      type="button"
                      data-thumb-index={String(idx)}
                      title={label || `Screenshot ${idx + 1}`}
                      aria-label={`Show screenshot ${idx + 1}: ${label || name}`}
                      class:list={[
                        "h-16 w-24 flex-shrink-0 overflow-hidden rounded-xl border bg-[#101010] transition sm:h-20 sm:w-32",
                        idx === 0
                          ? "border-skin-hue opacity-100"
                          : "border-white/10 opacity-50 hover:border-skin-hue/60 hover:opacity-100",
                      ]}
                    >
                      <img
                        src={`${baseUrl}${path}/${file}`}
                        alt=""
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    </button>
                  ),
                )}
              </div>
            )}
          </section>
        ) : (
          <section class="mb-16 flex min-h-56 items-center justify-center rounded-3xl border border-dashed border-skin-muted/30 bg-skin-button-muted/30 text-center">
            <div class="max-w-sm px-6 py-10">
              <>
                <Icon
                  name={langIcon ?? "mdi:code"}
                  class="mx-auto h-8 w-8 text-skin-hue/70"
                />
                <p class="mt-3 text-sm text-skin-muted">
                  Project preview coming soon
                </p>
              </>
            </div>
          </section>
        )
      }

      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
        <div class="space-y-14">
          <section>
            <p
              class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-skin-hue"
            >
              <!-- 01 <span class="mx-2 text-skin-muted">/</span> --> Overview
            </p>
            <h2
              class="text-2xl font-semibold tracking-tight text-skin-base sm:text-3xl"
            >
              A closer look
            </h2>
            <p class="mt-4 max-w-3xl text-base leading-8 text-skin-muted">
              {description}
            </p>
          </section>
          {
            highlights.length > 0 && (
              <section>
                <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-skin-hue">
                  {/* 02 <span class="mx-2 text-skin-muted">/</span> */} What it does
                </p>
                <h2 class="text-2xl font-semibold tracking-tight text-skin-base sm:text-3xl">
                  Features &amp; highlights
                </h2>
                <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                  {highlights.map((highlight: string, idx: number) => (
                    <li class="flex gap-4 rounded-2xl border border-skin-muted/15 bg-skin-button-muted/35 p-4 sm:p-5">
                      <span class="font-mono text-xs text-skin-hue">
                        {String(idx + 1).padStart(2, "0")}
                      </span>
                      <span
                        class="text-sm leading-6 text-skin-muted [&_i]:not-italic [&_i]:text-skin-base"
                        set:html={highlight}
                      />
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>

        <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
          <section
            class="rounded-2xl border border-skin-muted/15 bg-skin-button-muted/35 p-5 sm:p-6"
          >
            <p
              class="font-mono text-xs uppercase tracking-[0.2em] text-skin-hue"
            >
              Project info
            </p>
            <dl class="mt-5 divide-y divide-skin-muted/15 text-sm">
              <div class="flex items-center justify-between gap-3 py-3">
                <dt class="text-skin-muted">Status</dt><dd
                  class="font-medium text-skin-base"
                >
                  {isActive ? "Active" : "Archived"}
                </dd>
              </div>
              <div class="flex items-center justify-between gap-3 py-3">
                <dt class="text-skin-muted">Gallery</dt><dd
                  class="font-medium text-skin-base"
                >
                  {screenshots.length}&nbsp;
                  {screenshots.length === 1 ? "image" : "images"}
                </dd>
              </div>
              <div class="flex items-center justify-between gap-3 py-3">
                <dt class="text-skin-muted">Project</dt><dd
                  class="font-mono text-skin-base"
                >
                  #{projectNumber}
                </dd>
              </div>
            </dl>
          </section>

          {
            Object.keys(stack).length > 0 && (
              <section>
                <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-skin-hue">
                  Built with
                </p>
                <ul class="flex flex-wrap gap-2">
                  {(Object.entries(stack) as StackEntry[]).map(
                    ([label, icon]) => (
                      <li class="flex items-center gap-2 rounded-full border border-skin-muted/20 bg-skin-button-muted/35 px-3 py-2 text-xs text-skin-base transition hover:border-skin-hue/50">
                        {icon && (
                          <Icon name={icon} class="h-3.5 w-3.5 text-skin-hue" />
                        )}
                        {label}
                      </li>
                    ),
                  )}
                </ul>
              </section>
            )
          }

          {
            (github || (isActive && projectUrl)) && (
              <section class="rounded-2xl border border-skin-hue/20 bg-skin-hue/5 p-5">
                <p class="text-sm font-semibold text-skin-base">
                  Want to explore?
                </p>
                <p class="mt-2 text-xs leading-5 text-skin-muted">
                  Take a closer look at the live project or browse the source.
                </p>
                <div class="mt-4 flex flex-col gap-2">
                  {isActive && projectUrl && (
                    <a
                      href={projectUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center justify-between rounded-lg bg-skin-button-accent px-3 py-2.5 text-xs font-semibold text-skin-inverted transition hover:bg-skin-button-accent-hover"
                    >
                      Open live project{" "}
                      <Icon name="ri:arrow-right-up-line" class="h-4 w-4" />
                    </a>
                  )}
                  {github && (
                    <a
                      href={github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center justify-between rounded-lg border border-skin-muted/20 px-3 py-2.5 text-xs font-medium text-skin-base transition hover:border-skin-hue/50 hover:text-skin-hue"
                    >
                      <span class="flex items-center gap-2">
                        <Icon name="mdi:github" class="h-4 w-4" />
                        GitHub repository
                      </span>
                      <Icon name="ri:arrow-right-up-line" class="h-4 w-4" />
                    </a>
                  )}
                </div>
              </section>
            )
          }
        </aside>
      </div>

      <footer class="mt-16 border-t border-skin-muted/15 pt-6 print:hidden">
        <div
          class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"
        >
          <a
            href={baseUrl}
            class="group flex items-center gap-2 text-sm text-skin-muted transition hover:text-skin-base"
            ><Icon
              name="ri:arrow-left-line"
              class="h-4 w-4 transition-transform group-hover:-translate-x-1"
            />Back to all projects</a
          >
          {
            nextProject && nextProject.name !== name && (
              <a
                href={`${baseUrl}projects/${slugify(nextProject.name)}`}
                class="group flex flex-col items-start sm:items-end"
              >
                <>
                  <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-skin-muted">
                    Next project
                  </span>
                  <span class="mt-1 flex items-center gap-2 text-sm font-medium text-skin-base transition group-hover:text-skin-hue">
                    {nextProject.name}
                    <Icon
                      name="ri:arrow-right-line"
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                    />
                  </span>
                </>
              </a>
            )
          }
        </div>
      </footer>
    </main>
  </div>
</Layout>

<script>
  import { Fancybox } from "@fancyapps/ui";
  Fancybox.bind("[data-fancybox]", { hideScrollbar: false });

  const carousel = document.querySelector<HTMLElement>("[data-carousel]");
  if (carousel) {
    const slides = carousel.querySelectorAll<HTMLElement>(".carousel-slide");
    const thumbButtons =
      carousel.querySelectorAll<HTMLElement>("[data-thumb-index]");
    const captionEl = carousel.querySelector<HTMLElement>(
      "[data-carousel-caption]",
    );
    const counterEl = carousel.querySelector<HTMLElement>(
      "[data-carousel-counter]",
    );
    const prevBtn = carousel.querySelector<HTMLButtonElement>(".carousel-prev");
    const nextBtn = carousel.querySelector<HTMLButtonElement>(".carousel-next");

    let current = 0;
    const total = slides.length;

    function goTo(index: number) {
      const prev = current;
      current = ((index % total) + total) % total;
      if (prev === current) return;

      slides[prev].classList.remove("opacity-100", "z-10");
      slides[prev].classList.add("opacity-0", "z-0", "pointer-events-none");
      slides[current].classList.remove(
        "opacity-0",
        "z-0",
        "pointer-events-none",
      );
      slides[current].classList.add("opacity-100", "z-10");

      thumbButtons[prev]?.classList.remove("border-skin-hue", "opacity-100");
      thumbButtons[prev]?.classList.add("border-white/10", "opacity-50");
      thumbButtons[current]?.classList.remove("border-white/10", "opacity-50");
      thumbButtons[current]?.classList.add("border-skin-hue", "opacity-100");

      if (captionEl)
        captionEl.textContent = slides[current].dataset.caption ?? "";
      if (counterEl)
        counterEl.textContent = `${String(current + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
      thumbButtons[current]?.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
        inline: "center",
      });
    }

    prevBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      goTo(current - 1);
    });
    nextBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      goTo(current + 1);
    });
    thumbButtons.forEach((thumb, i) =>
      thumb.addEventListener("click", () => goTo(i)),
    );
  }
</script>
